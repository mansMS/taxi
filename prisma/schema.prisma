generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  DRIVER
  ADMIN
  OWNER
}

model User {
  id        String   @id @default(cuid())
  phone     String?  @unique
  name      String?
  role      Role     @default(CLIENT)
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
